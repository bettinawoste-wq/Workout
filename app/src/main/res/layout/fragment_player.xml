<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <!-- keepScreenOn on the root: the screen stays on for as long as the player is on screen,
         whatever the picture shows, and may turn off again once the player is left. -->

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- From the top down, so the picture sits right under the toolbar and nothing
                 below it moves between phases; leftover space collects at the bottom. -->

            <com.wob.workout.media.PictureFrameLayout
                android:id="@+id/mediaFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp">

                <com.wob.workout.media.FramedImageView
                    android:id="@+id/imgMedia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"/>

                <androidx.media3.ui.PlayerView
                    android:id="@+id/videoPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="false"/>

                <!-- Shown while a countdown previews the coming exercise, so it can't be
                     mistaken for the one running. -->
                <View
                    android:id="@+id/mediaScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#99000000"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/mediaLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtMediaLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:shadowColor="#CC000000"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtMediaTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:shadowColor="#CC000000"
                        android:shadowRadius="6"
                        android:textColor="#FFFFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Over everything in the frame, also over a video: a tap pauses or resumes
                     like the pause button, and the symbol flashes up as feedback. -->
                <FrameLayout
                    android:id="@+id/mediaTapTarget"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/pausieren_oder_fortsetzen"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgTapFeedback"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/bg_tap_feedback"
                        android:contentDescription="@null"
                        android:padding="20dp"
                        app:tint="#FFFFFFFF"/>
                </FrameLayout>
            </com.wob.workout.media.PictureFrameLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                app:trackCornerRadius="2dp"/>

            <LinearLayout
                android:id="@+id/rowWorkoutProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/txtWorkoutRemaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Sized to fit, since "Start in 3" is much wider than "00:48". No font padding,
                 so the digits sit close to the progress row above. -->
            <TextView
                android:id="@+id/txtTimer"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@null"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="00:00"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="80sp"
                app:autoSizeMinTextSize="32sp"
                app:autoSizeTextType="uniform"/>

            <!-- Always two lines high, so a long name doesn't push the buttons down. -->
            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/rowTransport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevious"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Vorherige Übung"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconSize="32dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPause"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Pause"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_pause"
                    app:iconSize="40dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Nächste Übung"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:icon="@drawable/ic_skip_next"
                    app:iconSize="32dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="start"/>
        </LinearLayout>
    </ScrollView>

    <!-- Outside the scrolling area, so it is always at hand at the bottom edge. -->
    <Button
        android:id="@+id/btnCancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="Workout abbrechen"/>

    <!-- In place of "Workout abbrechen" once the workout session is finished. -->
    <LinearLayout
        android:id="@+id/rowFinished"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnAgain"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/nochmal"/>

        <Button
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/fertig"/>
    </LinearLayout>
</LinearLayout>

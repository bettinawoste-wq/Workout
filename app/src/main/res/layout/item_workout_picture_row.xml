<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the picture strip on a workout. WorkoutAdapter relies on exactly
     PICTURES_PER_ROW frames, each holding one FramedImageView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <com.wob.workout.media.PictureFrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1">

        <com.wob.workout.media.FramedImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
    </com.wob.workout.media.PictureFrameLayout>

    <com.wob.workout.media.PictureFrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1">

        <com.wob.workout.media.FramedImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
    </com.wob.workout.media.PictureFrameLayout>

    <com.wob.workout.media.PictureFrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1">

        <com.wob.workout.media.FramedImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
    </com.wob.workout.media.PictureFrameLayout>

    <com.wob.workout.media.PictureFrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="1">

        <com.wob.workout.media.FramedImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
    </com.wob.workout.media.PictureFrameLayout>

    <com.wob.workout.media.PictureFrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        android:layout_weight="1">

        <com.wob.workout.media.FramedImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"/>
    </com.wob.workout.media.PictureFrameLayout>

</LinearLayout>

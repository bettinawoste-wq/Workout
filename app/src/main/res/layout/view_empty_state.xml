<?xml version="1.0" encoding="utf-8"?>
<!-- Shown where a screen has nothing yet: an icon, a hint and, where there is something to
     do about it, a button. Icon, text and button are set by EmptyState. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgEmptyIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:src="@drawable/ic_list"/>

    <TextView
        android:id="@+id/txtEmptyHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="@string/noch_keine_workouts"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptyAction"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        tools:text="@string/workout_anlegen"
        tools:visibility="visible"/>
</LinearLayout>
